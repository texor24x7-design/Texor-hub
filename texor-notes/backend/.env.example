# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4004

# Public origin of this product's frontend.
APP_ORIGIN=http://localhost:3004
# Browser origins allowed to call this API with cookies.
CORS_ORIGINS=http://localhost:3004

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/notes

# ── Texor Account (SSO) ───────────────────────────────────────────────────────
# Values come from `npm run seed` in texor-accounts/backend. Add the `notes`
# entry to its PRODUCTS list first, then re-run the seed for the secret.
TEXOR_ISSUER=http://localhost:4000/oidc
TEXOR_CLIENT_ID=notes
TEXOR_CLIENT_SECRET=
TEXOR_REDIRECT_URI=http://localhost:4004/api/auth/callback
TEXOR_SCOPE=openid profile email offline_access
# Audience for this product's own API tokens. Must match the client's
# resourceIndicator in Texor Account.
TEXOR_RESOURCE=https://api.notes.texor.app

# ── Cookies ───────────────────────────────────────────────────────────────────
# Random secret signing this product's session and PKCE cookies.
COOKIE_SECRET=dev-notes-cookie-secret-change-me
# Leave empty in dev; set to .texor.app in production.
COOKIE_DOMAIN=

# ── The notes API ─────────────────────────────────────────────────────────────
# Accounts allowed to mark an API key *trusted*. A trusted key may say which
# person a note belongs to, which is what lets Texor Talk file a meeting note in
# the account of whoever wrote it. Comma-separated email addresses; empty means
# no key can ever be trusted, and every key owns its own notes.
TRUSTED_KEY_EMAILS=
