# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4002

# Public origin of this product's frontend.
APP_ORIGIN=http://localhost:3002
# Browser origins allowed to call this API with cookies.
CORS_ORIGINS=http://localhost:3002

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/talk

# ── Texor Account (SSO) ───────────────────────────────────────────────────────
# Values come from `npm run seed` in texor-accounts/backend, or from the
# admin API at POST /api/admin/clients.
TEXOR_ISSUER=http://localhost:4000/oidc
TEXOR_CLIENT_ID=talk
TEXOR_CLIENT_SECRET=
TEXOR_REDIRECT_URI=http://localhost:4002/api/auth/callback
TEXOR_SCOPE=openid profile email offline_access
# Audience for this product's own API tokens. Must match the client's
# resourceIndicator in Texor Account.
TEXOR_RESOURCE=https://api.talk.texor.app

# ── Cookies ───────────────────────────────────────────────────────────────────
# Random secret signing this product's session and PKCE cookies.
COOKIE_SECRET=dev-talk-cookie-secret-change-me
# Leave empty in dev; set to .texor.app in production.
COOKIE_DOMAIN=

# ── Media (the SFU that runs inside this process) ──────────────────────────────
# There is nothing to sign up for and no service to point at: the media server
# is the `mediasoup` package in node_modules, and this process spawns it.
#
# The address browsers send audio and video to. It is written into the ICE
# candidates handed to the browser, so it has to be an address that browser can
# actually reach. 127.0.0.1 is right for one machine; a LAN or public address is
# required the moment a second device joins, or the call connects and stays silent.
MEDIA_ANNOUNCED_ADDRESS=127.0.0.1
# The UDP/TCP range the SFU binds for media. Open these in the firewall.
MEDIA_RTC_MIN_PORT=40000
MEDIA_RTC_MAX_PORT=40100
# One worker per CPU core. Defaults to the machine's core count.
# MEDIA_WORKERS=4
MEDIA_LOG_LEVEL=warn
# Ceiling per participant's outgoing video, in bits per second.

# ── Meetings ──────────────────────────────────────────────────────────────────
# How early a guest may join a scheduled meeting. Hosts are never held back.
MEETING_JOIN_EARLY_MINUTES=15
# A participant silent for this long is treated as having left, which is what
# closes out attendance after a browser crash.
MEETING_HEARTBEAT_TIMEOUT_SECONDS=90

# ── Administration ────────────────────────────────────────────────────────────
# Seeds the admin set for /admin. Deployment config, so it cannot be edited away
# from inside the console — this is the escape hatch from a policy lockout.
ADMIN_EMAILS=
# Email domains treated as internal. Anyone else is an external guest and the
# external-guest policy applies to them. Empty means nobody is external.
ORG_EMAIL_DOMAINS=

# Video bitrate is not configured here. An admin sets the organisation's
# ceiling in /admin and each host picks a tier within it, per meeting — so
# changing what a meeting costs never needs a deploy.

# ── Texor Notes (optional) ────────────────────────────────────────────────────
# Mirrors meeting notes into Texor Notes, in the account of whoever wrote them,
# and brings edits made there back. Both the origin and the key must be set or
# the mirror is off and Talk behaves exactly as it always has. The key has to be
# a *trusted* one: create it in Notes while signed in as an address listed in
# Notes' TRUSTED_KEY_EMAILS, with this deployment's
# <origin>/api/integrations/notes as its webhook address.
# NOTES_API_ORIGIN=http://localhost:4004
# NOTES_API_KEY=ntk_live__9gs26TuTv1g-ZEaRzLnXxv1rjX7bMkO4ngBSMjGBFw
# The webhook secret shown beside the key. Without it, edits made in Notes are
# refused rather than trusted, and the mirror only runs one way.
# NOTES_WEBHOOK_SECRET=CTnBv1dHt_6esa3OcrBwSRUrEmsdSJ22
