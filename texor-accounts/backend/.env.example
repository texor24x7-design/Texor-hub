# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Public origin of this backend. The OIDC issuer is ISSUER_ORIGIN + /oidc
# Dev:  http://localhost:4000
# Prod: https://api.accounts.texor.app   (or https://accounts.texor.app if same host)
ISSUER_ORIGIN=http://localhost:4000

# Where the Texor Account UI (Next.js) lives. Interactions redirect here.
ACCOUNTS_WEB_ORIGIN=http://localhost:3000

# Comma-separated list of browser origins allowed to call this API with cookies.
CORS_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/texor_accounts

# ── Cookies ───────────────────────────────────────────────────────────────────
# Leave COOKIE_DOMAIN empty in dev. In production set it to .texor.app so the
# Texor Account session is shared across every *.texor.app product.
COOKIE_DOMAIN=
# Two or more random secrets; the first one signs, the rest verify (key rotation).
COOKIE_KEYS=dev-cookie-key-change-me,dev-cookie-key-previous

# ── OIDC signing keys ─────────────────────────────────────────────────────────
# JSON array of private JWKs. Generate with: npm run keys:generate
OIDC_JWKS=

# 32 random bytes, base64. Encrypts registered product client secrets at rest.
# Generate with: npm run keys:generate
SECRET_ENCRYPTION_KEY=

# ── Bootstrap ─────────────────────────────────────────────────────────────────
# Seeded on `npm run seed` so you can reach the admin APIs.
SEED_ADMIN_EMAIL=admin@texor.app
SEED_ADMIN_PASSWORD=ChangeMe!12345

# ── Sign in with Google / Microsoft / LinkedIn ────────────────────────────────
# All optional. A provider appears on the sign-in screen only when both its
# client id and secret are set. Each provider's console needs this redirect URI
# registered:  ${ISSUER_ORIGIN}/api/auth/federated/<provider>/callback
#
# Google        https://console.cloud.google.com/apis/credentials
# Microsoft     https://entra.microsoft.com  → App registrations
# LinkedIn      https://www.linkedin.com/developers/apps  ("Sign In with LinkedIn using OpenID Connect")

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# `common` accepts work, school and personal accounts. Use a tenant GUID to
# restrict sign-in to one organisation.
MICROSOFT_TENANT=common

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Zoho account data centre: com · eu · in · com.au · jp · com.cn · ca
ZOHO_REGION=com

# ── Transactional email (Resend) ──────────────────────────────────────────────
# Required in production — email verification and password reset depend on it.
# Get a key at https://resend.com/api-keys
APP_NAME=Texor
RESEND_API_KEY=
# Must be a verified sender on your Resend account. The default below is
# Resend's shared sandbox address, which only delivers to your own inbox.
MAIL_FROM=Texor <onboarding@resend.dev>
MAIL_REPLY_TO=

# ── Uploads (Cloudinary) ──────────────────────────────────────────────────────
# Optional. Without these the profile picture falls back to a URL field.
# Credentials are at https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=texor/avatars
