# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4003

# Public origin of this product's frontend.
APP_ORIGIN=http://localhost:3003
# Browser origins allowed to call this API with cookies.
CORS_ORIGINS=http://localhost:3003

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/payroll

# ── Texor Account (SSO) ───────────────────────────────────────────────────────
# Values come from `npm run seed` in texor-accounts/backend, or from the
# admin API at POST /api/admin/clients.
TEXOR_ISSUER=http://localhost:4000/oidc
TEXOR_CLIENT_ID=payroll
TEXOR_CLIENT_SECRET=
TEXOR_REDIRECT_URI=http://localhost:4003/api/auth/callback
TEXOR_SCOPE=openid profile email offline_access
# Audience for this product's own API tokens. Must match the client's
# resourceIndicator in Texor Account.
TEXOR_RESOURCE=https://api.payroll.texor.app

# ── Cookies ───────────────────────────────────────────────────────────────────
# Random secret signing this product's session and PKCE cookies.
COOKIE_SECRET=dev-payroll-cookie-secret-change-me
# Leave empty in dev; set to .texor.app in production.
COOKIE_DOMAIN=
