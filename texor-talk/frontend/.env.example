# Origin of the Texor Talk backend.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4002

# ── The rest of the Texor ecosystem ───────────────────────────────────────────
# Where this product sends people for their account, and across to its siblings.
# A product with no origin here is simply not offered in the switcher. These
# fall back to the localhost ports below in development only: in production an
# unset origin stays empty, because a link to localhost is worse than no link.
NEXT_PUBLIC_ACCOUNTS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_FINVOICE_ORIGIN=http://localhost:3001
# This product's own public address. It is what a shared meeting link uses to
# name its preview image, so a wrong value shows a link card with no picture.
# On Vercel it is derived from the deployment if left unset; set it explicitly
# anywhere else.
NEXT_PUBLIC_TALK_ORIGIN=http://localhost:3002
NEXT_PUBLIC_PAYROLL_ORIGIN=http://localhost:3003
NEXT_PUBLIC_NOTES_ORIGIN=http://localhost:3004
