{
  "name": "notes-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Texor Notes — notes, labels and a notes API for the Texor ecosystem",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=20.11" },
  "scripts": {
