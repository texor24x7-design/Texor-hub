# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4001

# How often the background sweep runs (payment reminders, quote and warranty
# expiry nudges). 0 turns it off. One instance wins each tick via a lease.
SWEEP_INTERVAL_MINUTES=5

# This API as browsers reach it. Only needed when it differs from the origin of
# TEXOR_REDIRECT_URI — invoices embed absolute URLs for the logo, signature and fonts.
API_ORIGIN=
# Public origin of this product's frontend.
APP_ORIGIN=http://localhost:3001
# Browser origins allowed to call this API with cookies.
CORS_ORIGINS=http://localhost:3001

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/finvoice

# ── Texor Account (SSO) ───────────────────────────────────────────────────────
# Values come from `npm run seed` in texor-accounts/backend, or from the
# admin API at POST /api/admin/clients.
TEXOR_ISSUER=http://localhost:4000/oidc
TEXOR_CLIENT_ID=finvoice
TEXOR_CLIENT_SECRET=
TEXOR_REDIRECT_URI=http://localhost:4001/api/auth/callback
TEXOR_SCOPE=openid profile email offline_access
# Audience for this product's own API tokens. Must match the client's
# resourceIndicator in Texor Account.
TEXOR_RESOURCE=https://api.finvoice.texor.app

# ── Cookies ───────────────────────────────────────────────────────────────────
# Random secret signing this product's session and PKCE cookies.
COOKIE_SECRET=dev-finvoice-cookie-secret-change-me
# Leave empty in dev; set to .texor.app in production.
COOKIE_DOMAIN=

# ── Finvoice ──────────────────────────────────────────────────────────────────
# Origin that public document links (/d/:token) are built on. Defaults to APP_ORIGIN.
PUBLIC_ORIGIN=
UPLOAD_MAX_MB=5
# Encrypts integration secrets at rest. Required in production:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Optional — Gmail sending. Leave empty to hide the Gmail option.
# Create an OAuth client (Web application) in Google Cloud with the gmail.send
# scope; the redirect URI is this API's /api/integrations/gmail/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4001/api/integrations/gmail/callback

# Optional — use a system Chromium for PDFs instead of Puppeteer's download.
PUPPETEER_EXECUTABLE_PATH=
